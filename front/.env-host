# API Configuration
# For Railway backend, use the full URL with /api if your backend serves at /api
# If backend serves at root, just use the base URL
VITE_API_URL=https://imb-production.up.railway.app/api

# Google Maps API Key (required if using VITE_MAP_VERSION=google)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Map Version: 'google' or 'maplibre' (default: maplibre)
# - 'google': Uses Google Maps (requires VITE_GOOGLE_MAPS_API_KEY)
# - 'maplibre': Uses MapLibre GL (free, no API key required)
VITE_MAP_VERSION=maplibre
VITE_WHATSAPP_SERVICE_URL=https://fortunate-curiosity-production.up.railway.app