{
  "info": {
    "name": "WhatsApp Business Webhook",
    "description": "Collection for testing WhatsApp Business webhook endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": [""]
        },
        "description": "Check if the server is running"
      }
    },
    {
      "name": "Test Message (Simple)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"messageFrom\": \"+1234567890\",\n  \"message\": \"Hello from Postman! This is a test message.\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/webhook/test",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["webhook", "test"]
        },
        "description": "Simple endpoint to test message saving with just messageFrom and message fields"
      }
    },
    {
      "name": "Webhook - Text Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WHATSAPP_BUSINESS_ACCOUNT_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"15551234567\",\n              \"phone_number_id\": \"PHONE_NUMBER_ID\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"John Doe\"\n                },\n                \"wa_id\": \"1234567890\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"1234567890\",\n                \"id\": \"wamid.HBgNMTIzNDU2Nzg5MAVCABIYFjNFQjBDMUIyRjg4RUQxODFFRkUwAA==\",\n                \"timestamp\": \"1699632896\",\n                \"text\": {\n                  \"body\": \"Hello! This is a test message from WhatsApp.\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:3000/webhook",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["webhook"]
        },
        "description": "Simulate a WhatsApp text message webhook"
      }
    },
    {
      "name": "Webhook - Image Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WHATSAPP_BUSINESS_ACCOUNT_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"15551234567\",\n              \"phone_number_id\": \"PHONE_NUMBER_ID\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Jane Smith\"\n                },\n                \"wa_id\": \"9876543210\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"9876543210\",\n                \"id\": \"wamid.XXX\",\n                \"timestamp\": \"1699632900\",\n                \"type\": \"image\",\n                \"image\": {\n                  \"mime_type\": \"image/jpeg\",\n                  \"sha256\": \"abc123\",\n                  \"id\": \"IMAGE_ID\",\n                  \"caption\": \"Check out this photo!\"\n                }\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:3000/webhook",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["webhook"]
        },
        "description": "Simulate a WhatsApp image message webhook"
      }
    },
    {
      "name": "Webhook Verification",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/webhook?hub.mode=subscribe&hub.verify_token=my_secure_verify_token_123&hub.challenge=test_challenge_12345",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["webhook"],
          "query": [
            {
              "key": "hub.mode",
              "value": "subscribe"
            },
            {
              "key": "hub.verify_token",
              "value": "my_secure_verify_token_123"
            },
            {
              "key": "hub.challenge",
              "value": "test_challenge_12345"
            }
          ]
        },
        "description": "Verify the webhook (used by WhatsApp to confirm your endpoint)"
      }
    },
    {
      "name": "Get All Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/messages",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["messages"]
        },
        "description": "Retrieve all saved messages from the filesystem"
      }
    }
  ]
}

